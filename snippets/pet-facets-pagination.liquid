{% comment %}
  Renders pagination links that preserve active facet + sort params without JavaScript.

  Accepts:
  - paginate: the paginate object
  - base_url: page base url (may already contain a query string, e.g. search)
  - filters: results.filters (collection.filters or search.filters)
  - sort_by: current sort value
{% endcomment %}

{%- liquid
  assign params = ''
  for filter in filters
    if filter.type == 'price_range'
      if filter.min_value.value != null
        assign params = params | append: '&' | append: filter.min_value.param_name | append: '=' | append: filter.min_value.value
      endif
      if filter.max_value.value != null
        assign params = params | append: '&' | append: filter.max_value.param_name | append: '=' | append: filter.max_value.value
      endif
    else
      for value in filter.active_values
        assign params = params | append: '&' | append: value.param_name | append: '=' | append: value.value
      endfor
    endif
  endfor
  if sort_by != blank
    assign params = params | append: '&sort_by=' | append: sort_by
  endif

  assign page_sep = '?'
  if base_url contains '?'
    assign page_sep = '&'
  endif
-%}

<ul class="pagination" role="list">
  {%- if paginate.previous -%}
    <li>
      <a href="{{ base_url }}{{ page_sep }}page={{ paginate.current | minus: 1 }}{{ params }}" rel="prev" aria-label="Previous">
        <span aria-hidden="true">←</span>
      </a>
    </li>
  {%- endif -%}
  {%- for part in paginate.parts -%}
    <li>
      {%- if part.is_link -%}
        <a href="{{ base_url }}{{ page_sep }}page={{ part.title }}{{ params }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current -%}
        <span class="current" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span aria-hidden="true">{{ part.title }}</span>
      {%- endif -%}
    </li>
  {%- endfor -%}
  {%- if paginate.next -%}
    <li>
      <a href="{{ base_url }}{{ page_sep }}page={{ paginate.current | plus: 1 }}{{ params }}" rel="next" aria-label="Next">
        <span aria-hidden="true">→</span>
      </a>
    </li>
  {%- endif -%}
</ul>