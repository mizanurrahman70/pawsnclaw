{% comment %}
  This section is used in the collection template to render a designed
  collection page: a centered intro, a product count + sort toolbar, and a
  responsive grid of product cards.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}
<section class="pet-section pet-collection" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}{% render 'style-controls', section: section %}">
  <div class="pet-container">
    {% for block in section.blocks %}
      {% if block.type == 'intro' %}
        <header class="pet-collection__intro" style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow != blank %}<p class="pet-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
          <h1 class="pet-heading">{{ block.settings.heading | default: collection.title }}</h1>
          {% if block.settings.copy != blank %}
            <p class="pet-copy pet-collection__desc">{{ block.settings.copy }}</p>
          {% elsif collection.description != blank %}
            <p class="pet-copy pet-collection__desc">{{ collection.description }}</p>
          {% endif %}
        </header>
      {% endif %}
    {% endfor %}

    <div class="pet-collection__toolbar">
      <p class="pet-collection__count">{{ collection.products_count }} products</p>
      {% if section.settings.show_sort_by %}
        {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
        <form class="pet-collection__sort" action="{{ collection.url }}" method="get">
          <label for="sort-by-{{ section.id }}">Sort</label>
          <select id="sort-by-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
            {% for option in collection.sort_options %}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
            {% endfor %}
          </select>
        </form>
      {% endif %}
    </div>

    {% paginate collection.products by section.settings.products_per_page %}
      <div class="pet-collection__grid">
        {% for product in collection.products %}
          <article class="pet-product">
            <a href="{{ product.url }}" class="pet-product__image">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
              {% else %}
                <span class="pet-product__image--empty" aria-hidden="true">✦</span>
              {% endif %}
            </a>
            <div class="pet-product__body">
              <p class="pet-product__vendor">{{ product.vendor }}</p>
              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="pet-product__stars">★★★★★ <span>{{ product.metafields.reviews.rating.value | default: '4.8' }}</span></p>
              <strong>{{ product.price | money }}</strong>
            </div>
          </article>
        {% else %}
          <p class="pet-copy pet-collection__empty">No products in this collection yet.</p>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pet-collection__pagination" aria-label="Pagination">
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    { "type": "header", "content": "Product grid" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 4, "max": 48, "step": 4, "default": 12 },
    { "type": "checkbox", "id": "show_sort_by", "label": "Show sort by", "default": true },
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "color", "id": "text_color", "label": "Text color" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size", "label": "Heading size", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
    { "type": "range", "id": "body_font_size", "label": "Body text size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated for your pet" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "copy", "label": "Text" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection",
      "blocks": [
        { "type": "intro" }
      ]
    }
  ]
}
{% endschema %}