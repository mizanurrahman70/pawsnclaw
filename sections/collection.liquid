{% comment %}
  This section is used in the collection template to render a designed
  collection page: a centered intro, a filter sidebar, a product count + sort
  toolbar, and a responsive grid of product cards.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{{ 'section-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pet-facets.js' | asset_url }}" defer="defer"></script>

{%- assign has_filters = false -%}
{% for block in section.blocks %}
  {% if block.type == 'filters' %}
    {% assign has_filters = true %}
  {% endif %}
{% endfor %}

<section class="pet-section pet-collection" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}{% render 'style-controls', section: section %}">
  <div class="pet-container">
    {% for block in section.blocks %}
      {% if block.type == 'intro' %}
        <header class="pet-collection__intro" style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow != blank %}<p class="pet-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
          <h1 class="pet-heading">{{ block.settings.heading | default: collection.title }}</h1>
          {% if block.settings.copy != blank %}
            <p class="pet-copy pet-collection__desc">{{ block.settings.copy }}</p>
          {% elsif collection.description != blank %}
            <p class="pet-copy pet-collection__desc">{{ collection.description }}</p>
          {% endif %}
        </header>
      {% endif %}
    {% endfor %}

    {% assign has_faces = false %}
    {% for block in section.blocks %}
      {% if block.type == 'collection_face' and block.settings.collection != blank %}
        {% assign has_faces = true %}
      {% endif %}
    {% endfor %}

    {% if has_faces %}
      {% for block in section.blocks %}
        {% if block.type == 'collection_face' and block.settings.collection != blank %}
          {% assign face_collection = block.settings.collection %}
          <div class="pet-collection__face-group" style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
            <div class="pet-collection__face-head">
              <div>
                <h3><a href="{{ face_collection.url }}">{{ face_collection.title }}</a></h3>
                {% if block.settings.show_description and face_collection.description != blank %}
                  <p class="pet-collection__face-desc">{{ face_collection.description }}</p>
                {% endif %}
              </div>
              {% if block.settings.show_view_all %}
                <a class="pet-button pet-button--outline" href="{{ face_collection.url }}">View all →</a>
              {% endif %}
            </div>
            <div class="pet-collection__faces">
              {% for face_product in face_collection.products %}
                {% if block.settings.show_all_products == false and forloop.index > block.settings.products_to_show %}
                  {% break %}
                {% endif %}
                <article class="pet-product">
                  <a href="{{ face_product.url }}" class="pet-product__image">
                    {% if face_product.featured_image %}
                      {{ face_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: face_product.title }}
                    {% else %}
                      <span class="pet-product__image--empty" aria-hidden="true">✦</span>
                    {% endif %}
                  </a>
                  <div class="pet-product__body">
                    <p class="pet-product__vendor">{{ face_product.vendor }}</p>
                    <h3><a href="{{ face_product.url }}">{{ face_product.title }}</a></h3>
                    <p class="pet-product__stars">★★★★★ <span>{{ face_product.metafields.reviews.rating.value | default: '4.8' }}</span></p>
                    {% if block.settings.show_price %}<strong>{{ face_product.price | money }}</strong>{% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}

    <div class="pet-collection__layout{% unless has_filters %} pet-collection__layout--plain{% endunless %}">
      {% if has_filters %}
        <aside class="pet-collection__sidebar">
          {% for block in section.blocks %}
            {% if block.type == 'filters' %}
              <div style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h2 class="pet-collection__filter-title">{{ block.settings.heading }}</h2>
                {% endif %}
                {% render 'pet-facets', results: collection, facet_section_id: section.id, block: block, enable_sort_by: section.settings.show_sort_by %}
              </div>
            {% endif %}
          {% endfor %}
        </aside>
      {% endif %}

      <div class="pet-collection__content">
        <div class="pet-collection__toolbar">
          {% assign filtered_count = collection.products_count %}
          <p class="pet-collection__count">{{ filtered_count }} product{% if filtered_count != 1 %}s{% endif %}</p>
          {% if section.settings.show_sort_by and has_filters == false %}
            {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
            <form class="pet-collection__sort" action="{{ collection.url }}" method="get">
              <label for="sort-by-{{ section.id }}">Sort</label>
              <select id="sort-by-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
                {% for option in collection.sort_options %}
                  <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
                {% endfor %}
              </select>
              <noscript>
                <button type="submit" class="pet-button pet-button--small">Sort</button>
              </noscript>
            </form>
          {% endif %}
        </div>

        {% paginate collection.products by section.settings.products_per_page %}
          <div class="pet-collection__grid" data-facets-grid>
            {% for product in collection.products %}
              <article class="pet-product">
                <a href="{{ product.url }}" class="pet-product__image">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
                  {% else %}
                    <span class="pet-product__image--empty" aria-hidden="true">✦</span>
                  {% endif %}
                </a>
                <div class="pet-product__body">
                  <p class="pet-product__vendor">{{ product.vendor }}</p>
                  <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
                  <p class="pet-product__stars">★★★★★ <span>{{ product.metafields.reviews.rating.value | default: '4.8' }}</span></p>
                  <strong>{{ product.price | money }}</strong>
                </div>
              </article>
            {% else %}
              <p class="pet-copy pet-collection__empty">No products match your filters. <a href="{{ collection.url }}">Clear all filters</a>.</p>
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            {% assign facet_sort_by = collection.sort_by | default: collection.default_sort_by %}
            <nav class="pet-collection__pagination" aria-label="Pagination">
              {% render 'pet-facets-pagination', paginate: paginate, base_url: collection.url, filters: collection.filters, sort_by: facet_sort_by %}
            </nav>
          {% endif %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    { "type": "header", "content": "Product grid" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 4, "max": 48, "step": 4, "default": 12 },
    { "type": "checkbox", "id": "show_sort_by", "label": "Show sort by", "default": true },
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "color", "id": "text_color", "label": "Text color" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size", "label": "Heading size", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
    { "type": "range", "id": "body_font_size", "label": "Body text size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated for your pet" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "copy", "label": "Text" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    },
    {
      "type": "filters",
      "name": "Product filters",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Filter" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    },
    {
      "type": "collection_face",
      "name": "Collection face",
      "limit": 12,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Fetch products from an admin collection." },
        { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "unit": "px", "default": 4 },
        { "type": "checkbox", "id": "show_all_products", "label": "Show all products", "default": false, "info": "Display every product fetched from the collection instead of the limit above." },
        { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
        { "type": "checkbox", "id": "show_view_all", "label": "Show view all button", "default": true },
        { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection",
      "blocks": [
        { "type": "intro" }
      ]
    }
  ]
}
{% endschema %}