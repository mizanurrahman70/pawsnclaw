{{ 'section-announcement-bar.css' | asset_url | stylesheet_tag }}
<section class="announcement-bar" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}{% render 'style-controls', section: section %}">
  <div class="pet-container announcement-bar__inner">
    <div class="announcement-bar__left">
      {% for block in section.blocks %}
        {% if block.type == 'message' %}
          <div class="announcement-bar__message" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}<span class="announcement-bar__icon">{{ block.settings.icon }}</span>{% endif %}
            <span class="announcement-bar__text">{{ block.settings.text }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="announcement-bar__right">
      {% for block in section.blocks %}
        {% if block.type == 'link' %}
          <div class="announcement-bar__link" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {% else %}
              <span>{{ block.settings.text }}</span>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "section-announcement",
  "settings": [
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#087BE8" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "textarea", "id": "icon", "label": "Icon (SVG/Text)", "default": "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M19 7h-3V6a4 4 0 0 0-8 0v1H5a1 1 0 0 0-1 1v7a2 2 0 0 0 2 2h1v1a2 2 0 0 0 4 0v-1h2v1a2 2 0 0 0 4 0v-1h1a2 2 0 0 0 2-2V8a1 1 0 0 0-1-1zM10 6a2 2 0 0 1 4 0v1h-4V6zm-1 12a1 1 0 0 1-2 0v-2h2v2zm8 0a1 1 0 0 1-2 0v-2h2v2zm1-4H6V9h12v5z\"/></svg>" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $49!" }
      ]
    },
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Call us: 1-800-PAWS-LOVE" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message" },
        { "type": "link" },
        { "type": "link", "settings": { "text": "Track Order" } }
      ]
    }
  ]
}
{% endschema %}
