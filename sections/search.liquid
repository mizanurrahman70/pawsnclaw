{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  Menu links such as "Shop Cats" point to this template with a query
  (e.g. /search?q=cat&type=product), so products render as a store product
  grid, not a plain list.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

{{ 'section-search.css' | asset_url | stylesheet_tag }}
{{ 'section-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pet-facets.js' | asset_url }}" defer="defer"></script>

{%- assign has_filters = false -%}
{% for block in section.blocks %}
  {% if block.type == 'filters' %}
    {% assign has_filters = true %}
  {% endif %}
{% endfor %}

<section class="pet-section pet-search" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}">
  <div class="pet-container">
    <form class="pet-search__form" action="{{ routes.search_url }}" method="get" role="search">
      <input
        type="hidden"
        name="type"
        value="product"
      >
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        aria-label="{{ 'search.placeholder' | t }}"
      >
      <button class="pet-button" type="submit">{{ 'search.submit' | t }}</button>
    </form>

    {% if search.performed %}
      {% if search.results_count == 0 %}
        <p class="pet-search__empty pet-copy">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
      {% else %}
        <p class="pet-eyebrow pet-search__results">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

        <div class="pet-search__layout{% unless has_filters %} pet-search__layout--plain{% endunless %}">
          {% if has_filters %}
            <aside class="pet-search__sidebar">
              {% for block in section.blocks %}
                {% if block.type == 'filters' %}
                  <div style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
                    {% if block.settings.heading != blank %}
                      <h2 class="pet-search__filter-title">{{ block.settings.heading }}</h2>
                    {% endif %}
                    {% render 'pet-facets', results: search, facet_section_id: section.id, block: block, enable_sort_by: section.settings.show_sort_by %}
                  </div>
                {% endif %}
              {% endfor %}
            </aside>
          {% endif %}

          <div class="pet-search__results-wrap">
            {% if section.settings.show_sort_by and search.sort_options.size > 0 and has_filters == false %}
              {% assign sort_by = search.sort_by | default: search.default_sort_by %}
              <div class="pet-search__toolbar">
                <form class="pet-search__sort" action="{{ routes.search_url }}" method="get">
                  <input type="hidden" name="q" value="{{ search.terms | escape }}">
                  <input type="hidden" name="type" value="product">
                  <label class="visually-hidden" for="pet-search-sort-{{ section.id }}">Sort by</label>
                  <select id="pet-search-sort-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
                    {% for option in search.sort_options %}
                      <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
                    {% endfor %}
                  </select>
                  <noscript>
                    <button type="submit" class="pet-button pet-button--small">Sort</button>
                  </noscript>
                </form>
              </div>
            {% endif %}

            <div class="pet-search__grid">
              {% paginate search.results by 20 %}
                {% for result in search.results %}
                  <article class="pet-product">
                    {% assign featured_image = result.featured_image | default: result.image %}
                    <a href="{{ result.url }}" class="pet-product__image">
                      {% if featured_image %}
                        {{ featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: result.title }}
                      {% else %}
                        <span class="pet-product__image--empty" aria-hidden="true">✦</span>
                      {% endif %}
                    </a>
                    <div class="pet-product__body">
                      <p class="pet-product__vendor">{{ result.vendor }}</p>
                      <h3><a href="{{ result.url }}">{{ result.title }}</a></h3>
                      <p class="pet-product__stars">★★★★★ <span>{{ result.metafields.reviews.rating.value | default: '4.8' }}</span></p>
                      <strong>{{ result.price | money }}</strong>
                    </div>
                  </article>
                {% endfor %}

                {%- assign search_base_url = routes.search_url | append: '?q=' | append: search.terms | url_encode | append: '&type=product&options%5Bprefix%5D=last' -%}
                {%- assign facet_sort_by = search.sort_by | default: search.default_sort_by -%}
                {% if paginate.pages > 1 %}
                  <nav class="pet-search__pagination" aria-label="Pagination">
                    {% render 'pet-facets-pagination', paginate: paginate, base_url: search_base_url, filters: search.filters, sort_by: facet_sort_by %}
                  </nav>
                {% endif %}
              {% endpaginate %}
            </div>
          </div>
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.search",
  "settings": [
    { "type": "checkbox", "id": "show_sort_by", "label": "Show sort by", "default": true },
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" }
  ],
  "blocks": [
    {
      "type": "filters",
      "name": "Product filters",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Filter" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Search",
      "blocks": [
        { "type": "filters" }
      ]
    }
  ]
}
{% endschema %}