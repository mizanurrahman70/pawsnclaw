{{ 'section-pet-categories.css' | asset_url | stylesheet_tag }}
<section class="pet-section pet-categories"><div class="pet-container"><div class="pet-section__intro"><p class="pet-eyebrow">Curated collections</p><h2 class="pet-heading">Shop by category</h2><p class="pet-copy">Good things, chosen for the way your pet actually lives.</p></div><div class="pet-category-grid">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<a class="pet-category" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.title }}{% else %}<div class="pet-category__empty" aria-hidden="true">🐾</div>{% endif %}<div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.subtitle }}</p></div></a>{% endfor %}{% else %}<a class="pet-category pet-category--food" href="{{ routes.all_products_collection_url }}"><div class="pet-category__fallback" aria-hidden="true"><span>🥣</span></div><div><h3>Dog Food &amp; Treats</h3><p>120+ products</p></div></a><a class="pet-category pet-category--toys" href="{{ routes.all_products_collection_url }}"><div class="pet-category__fallback" aria-hidden="true"><span>🦴</span><span>🧶</span></div><div><h3>Indestructible Dog Toys</h3><p>85 products</p></div></a><a class="pet-category pet-category--cat-food" href="{{ routes.all_products_collection_url }}"><div class="pet-category__fallback" aria-hidden="true"><span>🐟</span></div><div><h3>Premium Cat Food</h3><p>90+ products</p></div></a><a class="pet-category pet-category--cat-toys" href="{{ routes.all_products_collection_url }}"><div class="pet-category__fallback" aria-hidden="true"><span>🐱</span><span>✦</span></div><div><h3>Interactive Cat Toys</h3><p>60 products</p></div></a>{% endif %}</div></div></section>
{% schema %}{"name":"Pet categories","blocks":[{"type":"category","name":"Category card","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Dog Food & Treats"},{"type":"text","id":"subtitle","label":"Subtitle","default":"120+ products"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":4,"presets":[{"name":"Pet categories","blocks":[{"type":"category","settings":{"title":"Dog Food & Treats","subtitle":"120+ products"}},{"type":"category","settings":{"title":"Indestructible Dog Toys","subtitle":"85 products"}},{"type":"category","settings":{"title":"Premium Cat Food","subtitle":"90+ products"}},{"type":"category","settings":{"title":"Interactive Cat Toys","subtitle":"60 products"}}]}]}{% endschema %}
