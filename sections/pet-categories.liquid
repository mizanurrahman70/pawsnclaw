{{ 'section-pet-categories.css' | asset_url | stylesheet_tag }}
<section class="pet-section pet-categories" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}{% render 'style-controls', section: section %}">
  <div class="pet-container">
    {% for block in section.blocks %}
      {% if block.type == 'intro' %}
        <div class="pet-section__intro" style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow != blank %}<p class="pet-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
          {% if block.settings.heading != blank %}<h2 class="pet-heading">{{ block.settings.heading }}</h2>{% endif %}
          {% if block.settings.copy != blank %}<p class="pet-copy">{{ block.settings.copy }}</p>{% endif %}
        </div>
      {% endif %}
    {% endfor %}

    <div class="pet-category-grid">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          {% liquid
            assign category_handle = block.settings.title | handle
            assign category_collection = collections[category_handle]
            if block.settings.link != blank
              assign category_url = block.settings.link
            elsif category_collection != blank
              assign category_url = category_collection.url
            else
              assign category_url = '/collections/' | append: category_handle
            endif
          %}
          <a class="pet-category" href="{{ category_url }}" style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {% else %}
              {% case block.settings.title %}
                {% when 'Dog Food & Treats' %}<img src="{{ 'catagory-Dog-Food-Treats.jpg' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                {% when 'Indestructible Dog Toys' %}<img src="{{ 'catagory-Indestructible-Dog-Toys.jpg' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                {% when 'Premium Cat Food' %}<img src="{{ 'catagory-Premium-Cat-Food.jpg' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                {% when 'Interactive Cat Toys' %}<img src="{{ 'catagory-Interactive-Cat-Toys.jpg' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                {% else %}<div class="pet-category__empty">🐾</div>
              {% endcase %}
            {% endif %}
            <div>
              <h3>{{ block.settings.title }}</h3>
              {% if block.settings.subtitle != blank %}
                <p>{{ block.settings.subtitle }}</p>
              {% elsif category_collection != blank %}
                <p>{{ category_collection.products_count }} products</p>
              {% endif %}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_products %}
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          {% liquid
            assign category_handle = block.settings.title | handle
            assign category_collection = collections[category_handle]
            if block.settings.link != blank
              assign category_url = block.settings.link
            elsif category_collection != blank
              assign category_url = category_collection.url
            else
              assign category_url = '/collections/' | append: category_handle
            endif
          %}
          {% if category_collection != blank and category_collection.products.size > 0 %}
            <div class="pet-cat-products" {{ block.shopify_attributes }}>
              <div class="pet-cat-products__head">
                <h3><a href="{{ category_url }}">{{ block.settings.title }}</a></h3>
                <a class="pet-button pet-button--outline" href="{{ category_url }}">View all →</a>
              </div>
              <div class="pet-products">
                {% for product in category_collection.products limit: section.settings.products_per_category %}
                  <article class="pet-product">
                    <a href="{{ product.url }}" class="pet-product__image">
                      {% if product.featured_image %}
                        {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
                      {% else %}
                        <span class="pet-product__image--empty" aria-hidden="true">🐾</span>
                      {% endif %}
                    </a>
                    <div class="pet-product__body">
                      <p class="pet-product__vendor">{{ product.vendor }}</p>
                      <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
                      <p class="pet-product__stars">★★★★★ <span>{{ product.metafields.reviews.rating.value | default: '4.8' }}</span></p>
                      <strong>{{ product.price | money }}</strong>
                    </div>
                  </article>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Pet categories",
  "settings": [
    { "type": "header", "content": "Collection products" },
    { "type": "checkbox", "id": "show_products", "label": "Show products per category", "default": true },
    { "type": "range", "id": "products_per_category", "label": "Products per category", "min": 4, "max": 8, "step": 1, "default": 4 },
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "color", "id": "text_color", "label": "Text color" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size", "label": "Heading size", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
    { "type": "range", "id": "body_font_size", "label": "Body text size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated collections" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
        { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>Good things, chosen for the way your pet actually lives.</p>" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    },
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Dog Food & Treats" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "120+ products" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Pet categories",
      "blocks": [
        { "type": "intro" },
        { "type": "category", "settings": { "title": "Dog Food & Treats", "subtitle": "120+ products" } },
        { "type": "category", "settings": { "title": "Indestructible Dog Toys", "subtitle": "85 products" } },
        { "type": "category", "settings": { "title": "Premium Cat Food", "subtitle": "90+ products" } },
        { "type": "category", "settings": { "title": "Interactive Cat Toys", "subtitle": "60 products" } }
      ]
    }
  ]
}
{% endschema %}