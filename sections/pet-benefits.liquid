{{ 'section-pet-benefits.css' | asset_url | stylesheet_tag }}
<section class="pet-benefits" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}">
  <div class="pet-container pet-benefits__grid">
    {% for block in section.blocks %}
      <article class="pet-benefit" {{ block.shopify_attributes }}>
        <span class="pet-benefit__icon">{{ block.settings.icon }}</span>
        <div>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Pet benefits",
  "settings": [
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "♡" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Vet-approved" },
        { "type": "text", "id": "text", "label": "Text", "default": "Made for healthier, happier pets" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Pet benefits",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}