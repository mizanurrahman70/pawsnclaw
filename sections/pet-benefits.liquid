{{ 'section-pet-benefits.css' | asset_url | stylesheet_tag }}
<section class="pet-benefits"><div class="pet-container pet-benefits__grid">{% for block in section.blocks %}<article class="pet-benefit" {{ block.shopify_attributes }}><span class="pet-benefit__icon">{{ block.settings.icon }}</span><div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div></article>{% endfor %}</div></section>
{% schema %}{"name":"Pet benefits","blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"icon","label":"Icon","default":"♡"},{"type":"text","id":"heading","label":"Heading","default":"Vet-approved"},{"type":"text","id":"text","label":"Text","default":"Made for healthier, happier pets"}]}],"max_blocks":4,"presets":[{"name":"Pet benefits","blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}]}]}{% endschema %}
