{{ 'section-pet-testimonials.css' | asset_url | stylesheet_tag }}
<section class="pet-section pet-testimonials" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}">
  <div class="pet-container">
    {% for block in section.blocks %}
      {% if block.type == 'intro' %}
        <div class="pet-section__intro" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow != blank %}<p class="pet-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
          {% if block.settings.heading != blank %}<h2 class="pet-heading">{{ block.settings.heading }}</h2>{% endif %}
          {% if block.settings.copy != blank %}<p class="pet-copy">{{ block.settings.copy }}</p>{% endif %}
        </div>
      {% endif %}
    {% endfor %}

    <div class="pet-testimonial-grid">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <blockquote class="pet-testimonial" {{ block.shopify_attributes }}>
            <div class="pet-testimonial__person">
              {% if block.settings.profile != blank %}
                {{ block.settings.profile | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {% else %}
                <img src="{{ 'review-profile.jpg' | asset_url }}" alt="{{ block.settings.name }}" loading="lazy">
              {% endif %}
              <div>
                <strong>{{ block.settings.name }}</strong>
                <small>{{ block.settings.pet }}</small>
              </div>
            </div>
            <p class="pet-testimonial__stars">★★★★★</p>
            <p>“{{ block.settings.quote }}”</p>
          </blockquote>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pet testimonials",
  "settings": [
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real reviews" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by pets, trusted by parents" },
        { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>Notes from happy pet parents.</p>" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "profile", "label": "Profile image" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Marcus K. & Milo" },
        { "type": "text", "id": "pet", "label": "Pet", "default": "Golden Retriever" },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "The quality is incredible and shipping was fast. Our pup is delighted!" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Pet testimonials",
      "blocks": [
        { "type": "intro" },
        { "type": "review" },
        { "type": "review", "settings": { "name": "Sophia L. & Cleo", "pet": "Maine Coon Cat" } },
        { "type": "review", "settings": { "name": "Jessica P. & Buster", "pet": "French Bulldog" } }
      ]
    }
  ]
}
{% endschema %}