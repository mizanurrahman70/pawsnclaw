{{ 'section-pet-testimonials.css' | asset_url | stylesheet_tag }}
<section class="pet-section pet-testimonials"><div class="pet-container"><div class="pet-section__intro"><p class="pet-eyebrow">Real reviews</p><h2 class="pet-heading">Loved by pets, trusted by parents</h2></div><div class="pet-testimonial-grid">{% for block in section.blocks %}<blockquote class="pet-testimonial" {{ block.shopify_attributes }}><div class="pet-testimonial__person"><span>🐾</span><div><strong>{{ block.settings.name }}</strong><small>{{ block.settings.pet }}</small></div></div><p class="pet-testimonial__stars">★★★★★</p><p>“{{ block.settings.quote }}”</p></blockquote>{% endfor %}</div></div></section>
{% schema %}{"name":"Pet testimonials","blocks":[{"type":"review","name":"Review","settings":[{"type":"text","id":"name","label":"Customer name","default":"Marcus K. & Milo"},{"type":"text","id":"pet","label":"Pet","default":"Golden Retriever"},{"type":"textarea","id":"quote","label":"Review","default":"The quality is incredible and shipping was fast. Our pup is delighted!"}]}],"max_blocks":3,"presets":[{"name":"Pet testimonials","blocks":[{"type":"review"},{"type":"review","settings":{"name":"Sophia L. & Cleo","pet":"Maine Coon Cat"}},{"type":"review","settings":{"name":"Jessica P. & Buster","pet":"French Bulldog"}}]}]}{% endschema %}
