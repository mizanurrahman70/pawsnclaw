{{ 'section-pet-related-products.css' | asset_url | stylesheet_tag }}
<section class="pet-section pet-related-products" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}{% render 'style-controls', section: section %}">
  <div class="pet-container">
    {% for block in section.blocks %}
      {% if block.type == 'intro' %}
        <div class="pet-section__intro" style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow != blank %}<p class="pet-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
          {% if block.settings.heading != blank %}<h2 class="pet-heading">{{ block.settings.heading }}</h2>{% endif %}
          {% if block.settings.copy != blank %}<p class="pet-copy">{{ block.settings.copy }}</p>{% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {% if section.settings.collection != blank %}
      {% assign related_collection = section.settings.collection %}
    {% elsif product.collections.first != blank %}
      {% assign related_collection = product.collections.first %}
    {% endif %}

    {% assign shown = 0 %}
    <div class="pet-related-products__grid">
      {% if related_collection != blank %}
        {% for related in related_collection.products %}
          {% if shown >= section.settings.products_to_show %}{% break %}{% endif %}
          {% if related.id == product.id %}{% continue %}{% endif %}
          {% assign shown = shown | plus: 1 %}
          <article class="pet-product">
            <a href="{{ related.url }}" class="pet-product__image">
              {% if related.featured_image %}
                {{ related.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: related.title }}
              {% else %}
                <span class="pet-product__image--empty" aria-hidden="true">✦</span>
              {% endif %}
              {% if related.compare_at_price > related.price %}<span class="pet-product__badge">Sale</span>{% endif %}
            </a>
            <div class="pet-product__body">
              <p class="pet-product__vendor">{{ related.vendor }}</p>
              <h3><a href="{{ related.url }}">{{ related.title }}</a></h3>
              {% assign related_rating = related.metafields.reviews.rating.value | default: 4.8 %}
              <p class="pet-product__stars">
                <span class="pet-product__stars-icons">★★★★★</span>
                <span class="pet-product__rating">{{ related_rating }}</span>
              </p>
              <div class="pet-product__footer">
                <div class="pet-product__prices">
                  <strong>{{ related.price | money }}</strong>
                  {% if related.compare_at_price > related.price %}
                    <s>{{ related.compare_at_price | money }}</s>
                  {% endif %}
                </div>
                <button class="pet-product__cart-btn" aria-label="Add to cart" type="button" data-url="{{ related.url }}">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                </button>
              </div>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    {% if shown == 0 and related_collection == blank %}
      <p class="pet-copy pet-related-products__empty">Related products will appear here based on the collection this item belongs to.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use the current product's collection automatically." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "color", "id": "text_color", "label": "Text color" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size", "label": "Heading size", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
    { "type": "range", "id": "body_font_size", "label": "Body text size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pairs perfectly with" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
        { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>Hand-picked companions for this pick.</p>" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Related products",
      "blocks": [
        { "type": "intro" }
      ]
    }
  ]
}
{% endschema %}