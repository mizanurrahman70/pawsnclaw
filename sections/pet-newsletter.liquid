{{ 'section-pet-newsletter.css' | asset_url | stylesheet_tag }}

<section class="pet-newsletter" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}">
  <div class="pet-container pet-newsletter__inner">
    {% assign intro_blocks = section.blocks | where: 'type', 'intro' %}
    {% if intro_blocks.size > 0 %}
      {% assign intro = intro_blocks.first %}
      <div class="pet-newsletter__intro" {{ intro.shopify_attributes }}>
        <span class="pet-newsletter__icon" aria-hidden="true">♧</span>
        <h2>{{ intro.settings.heading }}</h2>
        <div>{{ intro.settings.copy }}</div>
      </div>
    {% else %}
      <div class="pet-newsletter__intro">
        <span class="pet-newsletter__icon" aria-hidden="true">♧</span>
        <h2>Join the Paws &amp; Claws VIP Club</h2>
        <p>Sign up to receive 15% OFF your first order, exclusive access to flash drops, and expert pet tips.</p>
      </div>
    {% endif %}

    {% assign form_blocks = section.blocks | where: 'type', 'signup_form' %}
    {% if form_blocks.size > 0 %}{% assign signup = form_blocks.first %}{% else %}{% assign signup = blank %}{% endif %}
    {% form 'customer', class: 'pet-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="newsletter-email-{{ section.id }}">Email address</label>
      <span aria-hidden="true">✉</span>
      <input id="newsletter-email-{{ section.id }}" type="email" name="contact[email]" value="{% if form.errors %}{{ form.email }}{% endif %}" placeholder="{{ signup.settings.placeholder | default: 'Enter your pet-parent email...' }}" autocorrect="off" autocapitalize="off" required>
      <button type="submit">{{ signup.settings.button_label | default: 'Subscribe' }}</button>
      {% if form.posted_successfully? %}<p class="pet-newsletter__message">Thanks for joining the club!</p>{% endif %}
      {% if form.errors %}<p class="pet-newsletter__message">Please enter a valid email address.</p>{% endif %}
    {% endform %}
    <p class="pet-newsletter__fine-print">Zero spam. Unsubscribe at any time. We keep your details safe.</p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter signup",
  "settings": [
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 68 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Content",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Paws & Claws VIP Club" },
        { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>Sign up to receive 15% OFF your first order, exclusive access to flash drops, and expert pet tips.</p>" }
      ]
    },
    {
      "type": "signup_form",
      "name": "Signup form",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your pet-parent email..." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Newsletter signup", "blocks": [{ "type": "intro" }, { "type": "signup_form" }] }]
}
{% endschema %}
