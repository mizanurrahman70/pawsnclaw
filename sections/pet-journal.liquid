{{ 'section-pet-journal.css' | asset_url | stylesheet_tag }}
<section class="pet-section pet-journal"><div class="pet-container">{% for block in section.blocks %}{% if block.type == 'intro' %}<div class="pet-section__intro" {{ block.shopify_attributes }}>{% if block.settings.eyebrow != blank %}<p class="pet-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="pet-heading">{{ block.settings.heading }}</h2>{% endif %}{% if block.settings.copy != blank %}<p class="pet-copy">{{ block.settings.copy }}</p>{% endif %}</div>{% endif %}{% endfor %}<div class="pet-journal__grid">{% for block in section.blocks %}{% if block.type == 'article' %}<article class="pet-story" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}{% else %}<div class="pet-story__empty">🐈</div>{% endif %}<div class="pet-story__body"><p>{{ block.settings.category }} · {{ block.settings.read_time }}</p><h3>{{ block.settings.title }}</h3><a href="{{ block.settings.link }}">Read article →</a></div></article>{% endif %}{% endfor %}</div></div></section>
{% schema %}{"name":"Pet journal","blocks":[{"type":"intro","name":"Intro","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Helpful guides"},{"type":"text","id":"heading","label":"Heading","default":"Our pet care journal"},{"type":"richtext","id":"copy","label":"Text","default":"<p>Tips, tricks, and stories for the little lives that fill your home.</p>"}]},{"type":"article","name":"Journal card","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"category","label":"Category","default":"Cat health"},{"type":"text","id":"read_time","label":"Read time","default":"4 min read"},{"type":"text","id":"title","label":"Title","default":"Is your cat drinking enough water?"},{"type":"url","id":"link","label":"Article link"}]}],"max_blocks":4,"presets":[{"name":"Pet journal","blocks":[{"type":"intro"},{"type":"article"},{"type":"article","settings":{"category":"Dog training","title":"Best indestructible toys to cure puppy boredom"}},{"type":"article","settings":{"category":"Pet nutrition","title":"The ultimate guide to reading pet food labels"}}]}]}{% endschema %}