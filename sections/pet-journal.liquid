{{ 'section-pet-journal.css' | asset_url | stylesheet_tag }}
<section class="pet-section pet-journal"><div class="pet-container"><div class="pet-section__intro"><p class="pet-eyebrow">Helpful guides</p><h2 class="pet-heading">Our pet care journal</h2><p class="pet-copy">Tips, tricks, and stories for the little lives that fill your home.</p></div><div class="pet-journal__grid">{% for block in section.blocks %}<article class="pet-story" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}{% else %}<div class="pet-story__empty">🐈</div>{% endif %}<div class="pet-story__body"><p>{{ block.settings.category }} · {{ block.settings.read_time }}</p><h3>{{ block.settings.title }}</h3><a href="{{ block.settings.link }}">Read article →</a></div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Pet journal","blocks":[{"type":"article","name":"Journal card","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"category","label":"Category","default":"Cat health"},{"type":"text","id":"read_time","label":"Read time","default":"4 min read"},{"type":"text","id":"title","label":"Title","default":"Is your cat drinking enough water?"},{"type":"url","id":"link","label":"Article link"}]}],"max_blocks":3,"presets":[{"name":"Pet journal","blocks":[{"type":"article"},{"type":"article","settings":{"category":"Dog training","title":"Best indestructible toys to cure puppy boredom"}},{"type":"article","settings":{"category":"Pet nutrition","title":"The ultimate guide to reading pet food labels"}}]}]}{% endschema %}
