{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="pet-footer full-width">
  <div class="pet-container">
    <div class="pet-footer__grid">
      {% assign brand_blocks = section.blocks | where: 'type', 'brand' %}
      {% if brand_blocks.size > 0 %}{% assign brand = brand_blocks.first %}{% else %}{% assign brand = blank %}{% endif %}
      <div class="pet-footer__brand"{% if brand != blank %} {{ brand.shopify_attributes }}{% endif %}>
        <a href="{{ routes.root_url }}"><span>✦</span>{{ brand.settings.name | default: shop.name | default: 'PAWS&CLAW' }}</a>
        <div>{{ brand.settings.copy | default: 'We’re dedicated to improving the daily wellness and lifelong happiness of your best dog and cat friends.' }}</div>
        <p class="pet-footer__social"><a href="{{ brand.settings.facebook | default: routes.root_url }}" aria-label="Facebook">f</a><a href="{{ brand.settings.instagram | default: routes.root_url }}" aria-label="Instagram">◎</a><a href="{{ brand.settings.youtube | default: routes.root_url }}" aria-label="YouTube">▶</a></p>
      </div>
      {% assign menu_blocks = section.blocks | where: 'type', 'menu_column' %}
      {% for block in menu_blocks %}<div class="pet-footer__column" {{ block.shopify_attributes }}><h2>{{ block.settings.heading }}</h2>{% if block.settings.menu != blank %}<ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>{% else %}<ul><li><a href="{{ routes.all_products_collection_url }}">Shop all products</a></li><li><a href="{{ routes.search_url }}?q=dog&amp;type=product">Shop dogs</a></li><li><a href="{{ routes.search_url }}?q=cat&amp;type=product">Shop cats</a></li></ul>{% endif %}</div>{% endfor %}
    </div>
    <div class="pet-footer__bottom"><small>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. Powered by Shopify.</small><a href="{{ routes.cart_url }}">View cart</a></div>
  </div>
</footer>

{% schema %}
{"name":"Footer","blocks":[{"type":"brand","name":"Brand details","limit":1,"settings":[{"type":"text","id":"name","label":"Brand name","default":"PAWS&CLAW"},{"type":"textarea","id":"copy","label":"Description","default":"We’re dedicated to improving the daily wellness and lifelong happiness of your best dog and cat friends."},{"type":"url","id":"facebook","label":"Facebook link"},{"type":"url","id":"instagram","label":"Instagram link"},{"type":"url","id":"youtube","label":"YouTube link"}]},{"type":"menu_column","name":"Menu column","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop Dogs"},{"type":"link_list","id":"menu","label":"Menu"}]}],"max_blocks":4,"presets":[{"name":"Footer","blocks":[{"type":"brand"},{"type":"menu_column","settings":{"heading":"Shop Dogs"}},{"type":"menu_column","settings":{"heading":"Shop Cats"}},{"type":"menu_column","settings":{"heading":"Support & Care"}}]}]}{% endschema %}
