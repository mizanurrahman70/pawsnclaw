{{ 'section-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-cart.js' | asset_url }}" defer="defer"></script>

<section class="pet-section pet-cart" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}{% render 'style-controls', section: section %}">
  <div class="pet-container">
    {% for block in section.blocks %}
      {% if block.type == 'intro' %}
        <div class="pet-section__intro" style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow != blank %}<p class="pet-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
          {% if block.settings.heading != blank %}<h1 class="pet-heading">{{ block.settings.heading }}</h1>{% endif %}
          {% if block.settings.copy != blank %}<p class="pet-copy">{{ block.settings.copy }}</p>{% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {% if cart.empty? %}
      <div class="pet-cart__empty pet-cart-card">
        {% for block in section.blocks %}
          {% if block.type == 'empty_state' %}
            <div style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}<h2 class="pet-heading">{{ block.settings.heading }}</h2>{% endif %}
              {% if block.settings.copy != blank %}<p class="pet-copy pet-cart__empty-copy">{{ block.settings.copy }}</p>{% endif %}
              {% if block.settings.button_label != blank %}
                <a class="pet-button" href="{{ block.settings.button_link }}">{{ block.settings.button_label }} <span aria-hidden="true">→</span></a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" class="pet-cart__layout">
        <div class="pet-cart-card pet-cart__items">
          <div class="pet-cart__head">
            <h2 class="pet-cart__title">{{ 'cart.title' | t }}</h2>
            <p class="pet-cart__count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</p>
          </div>

          <ul class="pet-cart__list">
            {% for item in cart.items %}
              <li class="pet-cart__row">
                <a class="pet-cart__thumb" href="{{ item.url }}">
                  {% if item.image %}
                    {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', width: 300, height: 300, alt: item.product.title }}
                  {% else %}
                    <span class="pet-cart__thumb--empty" aria-hidden="true">🐾</span>
                  {% endif %}
                </a>

                <div class="pet-cart__info">
                  <p class="pet-cart__vendor">{{ item.product.vendor }}</p>
                  <h3 class="pet-cart__name"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                  {% unless item.product.has_only_default_variant %}
                    <p class="pet-cart__variant">{{ item.options_with_values | map: 'value' | join: ' / ' }}</p>
                  {% endunless %}
                  <a class="pet-cart__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                </div>

                <div class="pet-cart__qty" data-qty data-min="1">
                  <button type="button" class="pet-cart__step" data-qty-minus aria-label="Decrease quantity">−</button>
                  <input class="pet-cart__qty-input" type="number" name="updates[]" value="{{ item.quantity }}" min="1" aria-label="{{ item.product.title }} quantity">
                  <button type="button" class="pet-cart__step" data-qty-plus aria-label="Increase quantity">+</button>
                </div>

                <strong class="pet-cart__price">{{ item.final_line_price | money }}</strong>
              </li>
            {% endfor %}
          </ul>
        </div>

        <div class="pet-cart-card pet-cart__summary">
          <h2 class="pet-cart__title">Summary</h2>
          <div class="pet-cart__subtotal">
            <span>Subtotal</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="pet-cart__note">Shipping and taxes are calculated at checkout.</p>
          {% if cart.original_total_price > cart.total_price %}
            <p class="pet-cart__savings">You're saving {{ cart.original_total_price | minus: cart.total_price | money }}</p>
          {% endif %}
          <button type="submit" name="checkout" class="pet-button pet-cart__checkout">{{ 'cart.checkout' | t }} <span aria-hidden="true">→</span></button>
          <button type="submit" name="update" class="pet-button pet-button--outline pet-cart__update">{{ 'cart.update' | t }}</button>
          <a class="pet-cart__continue" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
        </div>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "color", "id": "text_color", "label": "Text color" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size", "label": "Heading size", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
    { "type": "range", "id": "body_font_size", "label": "Body text size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
        { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>Almost there — review your picks and check out when you're ready.</p>" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    },
    {
      "type": "empty_state",
      "name": "Empty cart message",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart is empty" },
        { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>You haven't added anything yet. Explore our collections and find something your pet will love.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Start shopping" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cart",
      "blocks": [
        { "type": "intro" },
        { "type": "empty_state" }
      ]
    }
  ]
}
{% endschema %}