{% comment %}
  This section is used in the product template to render a designed product
  page: media gallery, product info, variant/quantity form, trust badges, and
  accordions.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{{ 'section-product.css' | asset_url | stylesheet_tag }}
<section class="pet-section pet-product-detail" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}{% render 'style-controls', section: section %}">
  <div class="pet-container">
    {% for block in section.blocks %}
      {% if block.type == 'intro' %}
        <div class="pet-product-detail__intro" style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow != blank %}<p class="pet-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
          {% if block.settings.heading != blank %}<h2 class="pet-heading">{{ block.settings.heading }}</h2>{% endif %}
          {% if block.settings.copy != blank %}<p class="pet-copy">{{ block.settings.copy }}</p>{% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {% assign current_variant = product.selected_or_first_available_variant %}
    <div class="pet-product-detail__grid">
      <div class="pet-product-detail__media">
        <div class="pet-product-detail__main" id="pet-pd-main-{{ section.id }}">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 1100 | image_tag: loading: 'eager', alt: product.title }}
          {% else %}
            <span class="pet-product__image--empty" aria-hidden="true">✦</span>
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
          <div class="pet-product-detail__thumbs">
            {% for image in product.images %}
              <button
                type="button"
                class="pet-product-detail__thumb{% if forloop.first %} is-active{% endif %}"
                data-src="{{ image | image_url: width: 1100 }}"
                aria-label="View product image {{ forloop.index }}"
              >
                {{ image | image_url: width: 140 | image_tag: alt: product.title }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="pet-product-detail__info">
        {% if product.vendor != blank %}
          <p class="pet-eyebrow">{{ product.vendor }}</p>
        {% endif %}
        <h1 class="pet-product-detail__title">{{ product.title }}</h1>

        {% if section.settings.show_rating %}
          <p class="pet-product-detail__stars">★★★★★ <span>{{ product.metafields.reviews.rating.value | default: '4.8' }} &middot; {{ product.metafields.reviews.rating_count.value | default: '120+' }} reviews</span></p>
        {% endif %}

        <div class="pet-product-detail__price">
          <strong>{{ current_variant.price | money }}</strong>
          {% if current_variant.compare_at_price > current_variant.price %}
            <s>{{ current_variant.compare_at_price | money }}</s>
            <em>SAVE {{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price | round }}%</em>
          {% endif %}
        </div>

        <div class="pet-product-detail__desc">{{ product.description }}</div>

        <form class="pet-product-detail__form" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
          {% if product.variants.size > 1 %}
            <select class="pet-product-detail__variant" name="id">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}>
                  {{ variant.title }} — {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% endif %}

          <div class="pet-product-detail__qty-row">
            <div class="pet-product-detail__qty">
              <button type="button" data-qty="-1" aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" aria-label="Quantity">
              <button type="button" data-qty="1" aria-label="Increase quantity">+</button>
            </div>

            <button class="pet-button pet-product-detail__submit" type="submit" name="add">
              Add to cart
            </button>
          </div>
        </form>

        {% if section.settings.show_payment_button %}
          <div class="pet-product-detail__pay">
            {% form 'product', product %}
              {{ form | payment_button }}
            {% endform %}
          </div>
        {% endif %}

        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <details class="pet-pd-accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}</summary>
              <div class="pet-pd-accordion__body">{{ block.settings.text }}</div>
            </details>
          {% endif %}
        {% endfor %}

        {% if section.settings.show_badges %}
          <div class="pet-pd-trust">
            {% for block in section.blocks %}
              {% if block.type == 'trust' %}
                <div class="pet-pd-trust__item" {{ block.shopify_attributes }}>
                  <span>{{ block.settings.icon | default: '✓' }}</span>
                  <b>{{ block.settings.label }}</b>
                  {% if block.settings.copy != blank %}<p>{{ block.settings.copy }}</p>{% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var main = document.querySelector('#pet-pd-main-{{ section.id }} img');
    var thumbs = document.querySelectorAll('#shopify-section-{{ section.id }} .pet-product-detail__thumb');

    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        thumbs.forEach(function (t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
        if (main) {
          main.src = thumb.dataset.src;
          main.removeAttribute('srcset');
        }
      });
    });

    var qtyInput = document.querySelector('#shopify-section-{{ section.id }} .pet-product-detail__qty input');
    var qtyButtons = document.querySelectorAll('#shopify-section-{{ section.id }} .pet-product-detail__qty button');

    qtyButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var step = parseInt(btn.dataset.qty, 10);
        var value = parseInt(qtyInput.value, 10) || 1;
        qtyInput.value = Math.max(1, value + step);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    { "type": "header", "content": "Buy box" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "checkbox", "id": "show_badges", "label": "Show trust badges", "default": true },
    { "type": "checkbox", "id": "show_payment_button", "label": "Show dynamic checkout button", "default": true },
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "color", "id": "text_color", "label": "Text color" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size", "label": "Heading size", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
    { "type": "range", "id": "body_font_size", "label": "Body text size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The paw-picked pick" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "copy", "label": "Text" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "✓" },
        { "type": "text", "id": "label", "label": "Label", "default": "Free shipping" },
        { "type": "text", "id": "copy", "label": "Text", "default": "On all orders over $49" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shipping & returns" },
        { "type": "richtext", "id": "text", "label": "Content", "default": "<p>Free tracked shipping on all orders over $49. Easy 30-day returns.</p>" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "text_color", "label": "Text color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "trust" },
        { "type": "trust" },
        { "type": "trust" },
        { "type": "accordion" }
      ]
    }
  ]
}
{% endschema %}