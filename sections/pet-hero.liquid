{{ 'section-pet-hero.css' | asset_url | stylesheet_tag }}
{% assign image_blocks = section.blocks | where: 'type', 'image' %}
<section class="pet-hero{% if image_blocks.size == 0 %} pet-hero--no-media{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}">
  <div class="pet-container pet-hero__grid">
    <div class="pet-hero__copy">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'content' %}
            <div class="pet-hero__block" {{ block.shopify_attributes }}>
              {% if block.settings.eyebrow != blank %}<p class="pet-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
              {% if block.settings.heading != blank %}<h1>{{ block.settings.heading }}</h1>{% endif %}
              {% if block.settings.text != blank %}<div class="pet-copy">{{ block.settings.text }}</div>{% endif %}
              {% if block.settings.primary_label != blank or block.settings.secondary_label != blank %}
                <div class="pet-hero__actions">
                  {% if block.settings.primary_label != blank %}<a class="pet-button" href="{{ block.settings.primary_link }}">{{ block.settings.primary_label }} <span>→</span></a>{% endif %}
                  {% if block.settings.secondary_label != blank %}<a class="pet-button pet-button--outline" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label }}</a>{% endif %}
                </div>
              {% endif %}
            </div>
          {% when 'checks' %}
            <ul class="pet-hero__checks" {{ block.shopify_attributes }}>
              {% assign items = block.settings.items | split: '
' %}
              {% for item in items %}
                {% assign item = item | strip %}
                {% unless item == blank %}<li>✓ {{ item }}</li>{% endunless %}
              {% endfor %}
            </ul>
        {% endcase %}
      {% endfor %}
    </div>
    <div class="pet-hero__media-column">
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          <div class="pet-hero__media" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', widths: '500, 700, 1100', alt: block.settings.alt }}{% else %}<div class="pet-hero__placeholder"><span>🐕</span><span>🐈</span></div>{% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Pet hero","tag":"section","class":"pet-hero","settings":[{"type":"header","content":"Design controls"},{"type":"range","id":"padding_top","label":"Padding top","min":0,"max":120,"step":4,"unit":"px","default":72},{"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":120,"step":4,"unit":"px","default":72},{"type":"range","id":"margin_top","label":"Margin top","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Margin bottom","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"color","id":"background_color","label":"Background color"}],"max_blocks":8,"blocks":[{"type":"content","name":"Content","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Over 100,000+ happy pets served"},{"type":"text","id":"heading","label":"Heading","default":"Everything your best friend deserves, delivered to your door."},{"type":"richtext","id":"text","label":"Text","default":"<p>Shop premium organic foods, indestructible play-toys, ergonomic beds, and essential health supplies handpicked by expert veterinarians.</p>"},{"type":"text","id":"primary_label","label":"Primary button label","default":"Shop for Dogs"},{"type":"url","id":"primary_link","label":"Primary button link"},{"type":"text","id":"secondary_label","label":"Secondary button label","default":"Shop for Cats"},{"type":"url","id":"secondary_link","label":"Secondary button link"}]},{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"alt","label":"Image alt text"}]},{"type":"checks","name":"Trust checks","settings":[{"type":"textarea","id":"items","label":"Items (one per line)","default":"Fast shipping\nAuto-delivery, save 15%\nVet-approved picks"}]}],"presets":[{"name":"Pet hero","blocks":[{"type":"content"},{"type":"image"},{"type":"checks"}]}]}
{% endschema %}