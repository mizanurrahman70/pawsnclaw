{{ 'section-pet-hero.css' | asset_url | stylesheet_tag }}
{% assign image_blocks = section.blocks | where: 'type', 'image' %}
<section class="pet-hero{% if image_blocks.size == 0 %} pet-hero--no-media{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %};--pet-accent-color:{{ section.settings.accent_color | default: '#0276E0' }}{% render 'style-controls', section: section %}">
  <div class="pet-container pet-hero__grid">
    <div class="pet-hero__copy">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'content' %}
            <div class="pet-hero__block" style="{% render 'block-style-controls', block: block %}{% if block.settings.highlight_color != blank %} --pet-highlight-color: {{ block.settings.highlight_color }};{% endif %}" {{ block.shopify_attributes }}>
              {% if block.settings.eyebrow != blank %}<p class="pet-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
              {% if block.settings.heading != blank %}
                {% assign heading = block.settings.heading | newline_to_br %}
                {% if block.settings.highlight_text != blank %}
                  {% assign highlight_words = block.settings.highlight_text | split: ',' %}
                  {% for word in highlight_words %}
                    {% assign stripped_word = word | strip %}
                    {% assign highlight_html = '<em>' | append: stripped_word | append: '</em>' %}
                    {% assign heading = heading | replace: stripped_word, highlight_html %}
                  {% endfor %}
                {% endif %}
                <h1>{{ heading }}</h1>
              {% endif %}
              {% if block.settings.text != blank %}<div class="pet-copy">{{ block.settings.text }}</div>{% endif %}
              {% if block.settings.primary_label != blank or block.settings.secondary_label != blank %}
                <div class="pet-hero__actions">
                  {% if block.settings.primary_label != blank %}<a class="pet-button" href="{{ block.settings.primary_link }}">{{ block.settings.primary_label }} <span>→</span></a>{% endif %}
                  {% if block.settings.secondary_label != blank %}<a class="pet-button pet-button--outline" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label }}</a>{% endif %}
                </div>
              {% endif %}
            </div>
          {% when 'checks' %}
            {% assign checks_gap = block.settings.gap | default: 18 %}
            {% assign checks_icon_color = block.settings.icon_color | default: '#00A650' %}
            <ul class="pet-hero__checks" style="{% render 'block-style-controls', block: block %} gap:{{ checks_gap }}px; --check-color:{{ checks_icon_color }};" {{ block.shopify_attributes }}>
              {% assign items_raw = block.settings.items | newline_to_br | split: '<br />' %}
              {% for item in items_raw %}
                {% assign item = item | strip | strip_html %}
                {% unless item == blank %}
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--check-color)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    {{ item }}
                  </li>
                {% endunless %}
              {% endfor %}
            </ul>
        {% endcase %}
      {% endfor %}
    </div>
    <div class="pet-hero__media-column">
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          <div class="pet-hero__media" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', widths: '500, 700, 1100', alt: block.settings.alt }}{% else %}<img src="{{ 'hero-image.png' | asset_url }}" alt="{{ block.settings.alt | default: 'Happy pet with Paws & Claw products' }}" loading="eager">{% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Pet hero",
  "tag": "section",
  "class": "pet-hero",
  "settings": [
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "color", "id": "text_color", "label": "Text color" },
    { "type": "color", "id": "accent_color", "label": "Emphasis color", "default": "#0276E0" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size", "label": "Heading size", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
    { "type": "range", "id": "body_font_size", "label": "Body text size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "content",
      "name": "Content",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Over 100,000+ happy pets served" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Everything your best\nfriend deserves,\ndelivered to your door." },
        { "type": "text", "id": "highlight_text", "label": "Text to highlight", "default": "best, friend", "info": "Separate multiple words with commas" },
        { "type": "color", "id": "highlight_color", "label": "Highlight color", "default": "#0276E0" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Shop premium organic foods, indestructible play-toys, ergonomic beds, and essential health supplies handpicked by expert veterinarians.</p>" },
        { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop for Dogs" },
        { "type": "url", "id": "primary_link", "label": "Primary button link" },
        { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Shop for Cats" },
        { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Hero image" },
        { "type": "text", "id": "alt", "label": "Image alt text" }
      ]
    },
    {
      "type": "checks",
      "name": "Trust checks",
      "settings": [
        { "type": "textarea", "id": "items", "label": "Items (one per line)", "default": "Fast Shipping\nAuto-Delivery Save 15%\nVeterinary Approved" },
        { "type": "header", "content": "Design controls" },
        { "type": "range", "id": "gap", "label": "Gap between items", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },
        { "type": "color", "id": "icon_color", "label": "Checkmark color", "default": "#00A650" },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pet hero",
      "blocks": [
        { "type": "content" },
        { "type": "image" },
        { "type": "checks" }
      ]
    }
  ]
}
{% endschema %}