{{ 'section-pet-featured-products.css' | asset_url | stylesheet_tag }}
<section class="pet-section pet-featured" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px{% if section.settings.background_color != blank %};background-color:{{ section.settings.background_color }}{% endif %}{% render 'style-controls', section: section %}">
  <div class="pet-container">
    {% for block in section.blocks %}
      {% if block.type == 'intro' %}
        <div class="pet-section__intro" style="{% render 'block-style-controls', block: block %}" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow != blank %}<p class="pet-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
          {% if block.settings.heading != blank %}<h2 class="pet-heading">{{ block.settings.heading }}</h2>{% endif %}
          {% if block.settings.copy != blank %}<p class="pet-copy">{{ block.settings.copy }}</p>{% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {% assign featured_collection = section.settings.collection %}
    <div class="pet-products">
      {% if featured_collection != blank %}
        {% for product in featured_collection.products limit: 4 %}
          <article class="pet-product">
            <a href="{{ product.url }}" class="pet-product__image">{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}</a>
            <div class="pet-product__body">
              <p class="pet-product__vendor">{{ product.vendor }}</p>
              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="pet-product__stars">★★★★★ <span>{{ product.metafields.reviews.rating.value | default: '4.8' }}</span></p>
              <strong>{{ product.price | money }}</strong>
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <article class="pet-product">
            <div class="pet-product__image"><img src="{{ 'featured-pet.jpg' | asset_url }}" alt="Featured pet product" loading="lazy"></div>
            <div class="pet-product__body">
              <p class="pet-product__vendor">Paws & Claw pick</p>
              <h3>Favourite pet essential</h3>
              <p class="pet-product__stars">★★★★★ <span>4.9</span></p>
              <strong>$29.99</strong>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    {% for block in section.blocks %}
      {% if block.type == 'button' and block.settings.label != blank %}
        <p class="pet-featured__action" {{ block.shopify_attributes }}><a class="pet-button pet-button--outline" href="{{ block.settings.link }}">{{ block.settings.label }}</a></p>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Pet featured products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "header", "content": "Design controls" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "color", "id": "text_color", "label": "Text color" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size", "label": "Heading size", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
    { "type": "range", "id": "body_font_size", "label": "Body text size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community favourites" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Our best sellers" },
        { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>The dependable picks pets and people come back for.</p>" },
        { "type": "header", "content": "Design controls" },
        { "type": "color", "id": "heading_color", "label": "Heading color" },
        { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "background_color", "label": "Background color" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "View all products" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pet featured products",
      "blocks": [
        { "type": "intro" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}