{{ 'section-pet-featured-products.css' | asset_url | stylesheet_tag }}
<section class="pet-section pet-featured"><div class="pet-container"><div class="pet-section__intro"><p class="pet-eyebrow">Community favourites</p><h2 class="pet-heading">Our best sellers</h2><p class="pet-copy">The dependable picks pets and people come back for.</p></div>{% assign featured_collection = section.settings.collection %}<div class="pet-products">{% if featured_collection != blank %}{% for product in featured_collection.products limit: 4 %}<article class="pet-product"><a href="{{ product.url }}" class="pet-product__image">{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}</a><div class="pet-product__body"><p class="pet-product__vendor">{{ product.vendor }}</p><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><p class="pet-product__stars">★★★★★ <span>{{ product.metafields.reviews.rating.value | default: '4.8' }}</span></p><strong>{{ product.price | money }}</strong></div></article>{% endfor %}{% else %}{% for i in (1..4) %}<article class="pet-product"><div class="pet-product__image pet-product__image--empty">🐾</div><div class="pet-product__body"><p class="pet-product__vendor">Paws & Claw pick</p><h3>Favourite pet essential</h3><p class="pet-product__stars">★★★★★ <span>4.9</span></p><strong>$29.99</strong></div></article>{% endfor %}{% endif %}</div>{% if section.settings.button_label != blank %}<p class="pet-featured__action"><a class="pet-button pet-button--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></p>{% endif %}</div></section>
{% schema %}{"name":"Pet featured products","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"button_label","label":"Button label","default":"View all products"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Pet featured products"}]}{% endschema %}
